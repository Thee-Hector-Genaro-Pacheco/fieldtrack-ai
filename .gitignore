# Python virtual environments
.venv/
**/.venv/

# Python cache files
__pycache__/
**/__pycache__/
*.py[cod]

# Test and tooling caches
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/

# Environment secrets
.env
**/.env
!.env.example
!**/.env.example

# macOS
.DS_Store

